# /etc/abs-alexa.env  (chmod 600, owned by root)
# Public HTTPS URL of Audiobookshelf -- Echo devices stream audio from here.
SERVER_URL=https://abs.example.com
# Optional: API calls go here instead (same host => faster, no tunnel hop).
ABS_INTERNAL_URL=http://127.0.0.1:13378
# Audiobookshelf API key (Settings -> API Keys).
ABS_API_KEY=changeme
# Optional: only accept requests for this skill id (amzn1.ask.skill....).
#SKILL_ID=
PORT=3000
BIND=127.0.0.1
